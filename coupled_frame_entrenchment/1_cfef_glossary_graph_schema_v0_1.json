{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontology-schema:glossary-graph:1.0.0",
  "title": "Glossary Graph Schema",
  "description": "Schema for a compact terminology-positioning graph. It distinguishes definitions, inclusions, exclusions, near-neighbours, contrasts, and usage guidance without making the glossary carry the full ontology.",
  "type": "object",
  "required": [
    "manifest",
    "relation_vocabulary",
    "nodes",
    "edges"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "title",
        "version",
        "status",
        "description",
        "namespace",
        "counts"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "created_utc": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anti_collapse_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counts": {
          "type": "object",
          "required": [
            "nodes",
            "edges",
            "relations"
          ],
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            },
            "relations": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "relation_vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "definition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "definition": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "definition",
          "status",
          "confidence",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "core",
              "settled",
              "provisional",
              "candidate",
              "rejected",
              "canonical_seed"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "glossary",
              "term",
              "near_neighbour",
              "exclusion",
              "criterion",
              "warning",
              "method"
            ]
          },
          "canonical_use": {
            "type": "string"
          },
          "not_to_be_used_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "relation",
          "target",
          "status",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "relation": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "definition": {
            "type": "string"
          },
          "status": {
            "enum": [
              "core",
              "settled",
              "provisional",
              "candidate",
              "rejected",
              "canonical_seed"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
